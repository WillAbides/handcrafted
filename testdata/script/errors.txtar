# A missing file stops processing after any earlier matches.
stdin files
! exec handcrafted
cmp stdout want-handcrafted
stderr 'could not read file missing\.go:'

# The same failure stops generated-file filtering.
stdin files
! exec handcrafted -generated
cmp stdout want-generated
stderr 'could not read file missing\.go:'

# Read errors also stop processing.
mkdir directory
stdin read-error
! exec handcrafted
cmp stdout empty-output
stderr 'could not read file directory:'

stdin read-error
! exec handcrafted -generated
cmp stdout empty-output
stderr 'could not read file directory:'

-- files --
before.go
before-generated.go
invalid.go
missing.go
after.go
after-generated.go
-- want-handcrafted --
before.go
-- want-generated --
before-generated.go
-- read-error --
directory
after.go
-- before.go --
package example
-- before-generated.go --
// Code generated by example DO NOT EDIT.
package example
-- invalid.go --
not Go
-- after.go --
package example
-- after-generated.go --
// Code generated by example DO NOT EDIT.
package example
-- empty-output --
