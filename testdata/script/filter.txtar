# Filter handcrafted files in input order.
stdin files
exec handcrafted
cmp stdout want-handcrafted
cmp stderr empty-output

# The generated flag selects the complementary valid files.
stdin files
exec handcrafted -generated
cmp stdout want-generated
cmp stderr empty-output

# The -z flag reads and writes NUL-delimited filenames.
lines2nul files want-handcrafted want-generated
stdin files
exec handcrafted -z
cmp stdout want-handcrafted
cmp stderr empty-output

stdin files
exec handcrafted -z -generated
cmp stdout want-generated
cmp stderr empty-output

-- files --
generated.go
plain.go
indented.go
different.go
after-package.go
raw-string.go
invalid-body.go
invalid-package.go
missing-package.go
empty.go
with spaces.go
last.go
-- want-handcrafted --
plain.go
different.go
after-package.go
raw-string.go
with spaces.go
last.go
-- want-generated --
generated.go
indented.go
invalid-body.go
-- generated.go --
// Code generated by example DO NOT EDIT.

package example
-- plain.go --
package example
-- indented.go --
  // Code generated by example DO NOT EDIT.
package example
-- different.go --
// Code generated by example. DO NOT MODIFY.
package example
-- after-package.go --
package example
// Code generated by example DO NOT EDIT.
-- raw-string.go --
package example
var text = `
// Code generated by example DO NOT EDIT.
`
-- invalid-body.go --
// Code generated by example DO NOT EDIT.
package example
func {
-- invalid-package.go --
// Code generated by example DO NOT EDIT.
not Go
-- missing-package.go --
not Go
-- empty.go --
-- with spaces.go --
package example
-- last.go --
package example
-- empty-output --
